{
    "name": "f3lix/message-bundle",
    "description": "Messaging-Infrastruktur für Symfony-Microservices: Transactional Outbox, RabbitMQ, Retry beim Konsum, Löschaufträge und Logging über AMQP",
    "minimum-stability": "stable",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "F3lix",
            "email": "info@ronnykraemer.de"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "ext-amqp": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.1",
        "monolog/monolog": "^3.12",
        "psr/log": "^3.0",
        "symfony/amqp-messenger": "^8.0",
        "symfony/clock": "^8.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/monolog-bundle": "^4.1",
        "symfony/uid": "^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "phpunit/phpunit": "Für die Assertions und Test-Doubles im Namespace F3lix\\MessageBundle\\Testing"
    },
    "autoload": {
        "psr-4": {
            "F3lix\\MessageBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "F3lix\\MessageBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "extra": {
        "symfony": {
            "bundle": "F3lix\\MessageBundle\\MessageBundle"
        }
    }
}
